    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# -*- coding: utf-8 -*-\n\"\"\"\nLevantamiento -> Revit  (Dynamo 3.x, motor CPython3 — Revit 2025)\n\nLee el archivo \"..._revit.json\" que exporta la app de levantamiento. El ±0,00 del levantamiento se\nubica en el nivel más bajo del modelo (o en el nivel indicado en IN[1]); cada nivel del levantamiento\nusa el nivel de Revit que esté a su cota (NPT) o se crea uno nuevo con su vista de planta. En cada nivel crea:\n  - Tipos de muro \"Levantamiento NN cm\" (una capa, según espesor) y muros nativos por su eje, con su altura.\n  - Puertas, ventanas y ventanales: duplica un tipo de la familia cargada con el ancho y alto medidos.\n  - Vanos vacíos: aberturas rectangulares en el muro.\n  - Habitaciones con el nombre y la altura de cada recinto.\n  - Pilares: columnas estructurales (o arquitectónicas si no hay) con su sección, altura y giro.\n  - Ejes de referencia como Rejillas (Grids) con su nombre (una sola vez aunque se repitan en varios niveles).\n\nEntradas:\n  IN[0]  ruta del archivo .json (nodo File Path)\n  IN[1]  (opcional) nombre del nivel de Revit que corresponde al ±0,00. Vacío = nivel más bajo\n  IN[2]  (opcional) texto que contenga el nombre de la familia de puertas a usar\n  IN[3]  (opcional) texto que contenga el nombre de la familia de ventanas a usar\n  IN[4]  (opcional) texto que contenga el nombre de la familia de pilares a usar\nEjecutar UNA sola vez en modo Manual: cada ejecución vuelve a crear los elementos.\n\"\"\"\nimport clr, json, math\nclr.AddReference('RevitAPI')\nfrom Autodesk.Revit.DB import *\nfrom Autodesk.Revit.DB.Structure import StructuralType\nclr.AddReference('RevitServices')\nfrom RevitServices.Persistence import DocumentManager\nfrom RevitServices.Transactions import TransactionManager\n\ndoc = DocumentManager.Instance.CurrentDBDocument\n\ndef _in(i, default=None):\n    try:\n        v = IN[i]\n        return v if v not in (None, '') else default\n    except Exception:\n        return default\n\npath = _in(0)\nlevel_name = _in(1)\ndoor_hint = (_in(2) or '').lower()\nwin_hint = (_in(3) or '').lower()\ncol_hint = (_in(4) or '').lower()\n\nFT = 1.0 / 0.3048\ndef ft(m): return float(m) * FT\n\nreport = []\n\ndef type_name(e):\n    p = e.get_Parameter(BuiltInParameter.SYMBOL_NAME_PARAM)\n    return p.AsString() if p else ''\n\ndef family_name(sym):\n    try:\n        return sym.Family.Name\n    except Exception:\n        p = sym.get_Parameter(BuiltInParameter.SYMBOL_FAMILY_NAME_PARAM)\n        return p.AsString() if p else ''\n\nimport os\nif not path or not os.path.isfile(str(path)):\n    raise Exception('Primero elige el archivo _revit.json en el nodo 1) con \"Examinar...\" y vuelve a ejecutar.')\nwith open(path, encoding='utf-8') as f:\n    data = json.load(f)\n\n# ---------- niveles ----------\nrv_levels = sorted(FilteredElementCollector(doc).OfClass(Level).ToElements(), key=lambda l: l.Elevation)\nbase = rv_levels[0]\nif level_name:\n    for l in rv_levels:\n        if l.Name == level_name:\n            base = l\nbase_z = base.Elevation      # pies; corresponde al ±0,00 del levantamiento\n\n# archivos antiguos (un solo nivel) -> mismo formato que los nuevos\nif 'levels' not in data:\n    data['levels'] = [{'name': 'Nivel 1', 'elevation': 0.0, 'walls': data.get('walls', []),\n                       'openings': data.get('openings', []), 'rooms': data.get('rooms', [])}]\n\nplan_vft = None\nfor vft in FilteredElementCollector(doc).OfClass(ViewFamilyType).ToElements():\n    if vft.ViewFamily == ViewFamily.FloorPlan:\n        plan_vft = vft\n        break\n\ndef level_for(lv):\n    z = base_z + ft(lv.get('elevation', 0))\n    for l in FilteredElementCollector(doc).OfClass(Level).ToElements():\n        if abs(l.Elevation - z) < 0.01:          # ~3 mm\n            return l, False\n    nl = Level.Create(doc, z)\n    try:\n        nl.Name = lv.get('name') or nl.Name\n    except Exception:\n        try:\n            nl.Name = '%s (levantamiento)' % lv.get('name')\n        except Exception:\n            pass\n    if plan_vft is not None:\n        try:\n            vp = ViewPlan.Create(doc, plan_vft.Id, nl.Id)\n            try:\n                vp.Name = nl.Name\n            except Exception:\n                pass\n        except Exception:\n            pass\n    return nl, True\n\n# ---------- tipos de muro ----------\nbasic_types = [t for t in FilteredElementCollector(doc).OfClass(WallType).ToElements() if t.Kind == WallKind.Basic]\nwall_types = {}\ndef wall_type(thk):\n    cm = int(round(thk * 100))\n    if cm in wall_types:\n        return wall_types[cm]\n    name = 'Levantamiento %d cm' % cm\n    for t in basic_types:\n        if type_name(t) == name:\n            wall_types[cm] = t\n            return t\n    nt = doc.GetElement(basic_types[0].Duplicate(name).Id)\n    cs = CompoundStructure.CreateSingleLayerCompoundStructure(MaterialFunctionAssignment.Structure, ft(thk), ElementId.InvalidElementId)\n    nt.SetCompoundStructure(cs)\n    wall_types[cm] = nt\n    report.append('Tipo de muro creado: ' + name)\n    return nt\n\n# ---------- tipos de puerta / ventana ----------\ndef symbols(cat, hint):\n    syms = list(FilteredElementCollector(doc).OfClass(FamilySymbol).OfCategory(cat).ToElements())\n    if hint:\n        pref = [s for s in syms if hint in family_name(s).lower()]\n        if pref:\n            return pref\n    return syms\n\ndef set_len(elem, names, bips, value):\n    for b in bips:\n        bip = getattr(BuiltInParameter, b, None)\n        if bip is None:\n            continue\n        p = elem.get_Parameter(bip)\n        if p and not p.IsReadOnly:\n            p.Set(value)\n            return True\n    for n in names:\n        p = elem.LookupParameter(n)\n        if p and not p.IsReadOnly and p.StorageType == StorageType.Double:\n            p.Set(value)\n            return True\n    return False\n\nsym_cache = {}\ndef symbol_for(kind, w, h):\n    cat = BuiltInCategory.OST_Doors if kind == 'door' else BuiltInCategory.OST_Windows\n    hint = door_hint if kind == 'door' else win_hint\n    base_list = symbols(cat, hint)\n    if not base_list:\n        return None\n    base = base_list[0]\n    fam = family_name(base)\n    name = '%s %dx%d' % ('Lev', int(round(w * 100)), int(round(h * 100)))\n    key = (fam, name)\n    if key in sym_cache:\n        return sym_cache[key]\n    for s in base_list:\n        if family_name(s) == fam and type_name(s) == name:\n            sym_cache[key] = s\n            return s\n    ns = doc.GetElement(base.Duplicate(name).Id)\n    okw = set_len(ns, ['Width', 'Anchura', 'Ancho'], ['DOOR_WIDTH', 'WINDOW_WIDTH', 'FAMILY_WIDTH_PARAM'], ft(w))\n    okh = set_len(ns, ['Height', 'Altura', 'Alto'], ['DOOR_HEIGHT', 'WINDOW_HEIGHT', 'FAMILY_HEIGHT_PARAM'], ft(h))\n    if not (okw and okh):\n        report.append('Aviso: no se pudo fijar ancho/alto en la familia \"%s\"; revisa el tipo %s' % (fam, name))\n    if not ns.IsActive:\n        ns.Activate()\n    sym_cache[key] = ns\n    return ns\n\ncol_cache = {}\ndef column_symbol(w, d):\n    # primero columnas estructurales; si no hay cargadas, columnas arquitectónicas\n    for cat, structural in ((BuiltInCategory.OST_StructuralColumns, True), (BuiltInCategory.OST_Columns, False)):\n        base_list = symbols(cat, col_hint)\n        if not base_list:\n            continue\n        base = base_list[0]; fam = family_name(base)\n        name = 'Lev %dx%d' % (int(round(w * 100)), int(round(d * 100)))\n        key = (fam, name)\n        if key in col_cache:\n            return col_cache[key], structural\n        for s_ in base_list:\n            if family_name(s_) == fam and type_name(s_) == name:\n                col_cache[key] = s_\n                return s_, structural\n        ns = doc.GetElement(base.Duplicate(name).Id)\n        okw = set_len(ns, ['b', 'Width', 'Anchura', 'Ancho'], [], ft(w))\n        okd = set_len(ns, ['h', 'Depth', 'Profundidad', 'Fondo', 'Largo'], [], ft(d))\n        if not (okw and okd):\n            report.append('Aviso: no se pudo fijar la sección en la familia de pilares \"%s\"; revisa el tipo %s' % (fam, name))\n        if not ns.IsActive:\n            ns.Activate()\n        col_cache[key] = ns\n        return ns, structural\n    return None, False\n\n# ---------- crear ----------\nTransactionManager.Instance.EnsureInTransaction(doc)\n\ngrid_names = set()\nfor g_ in FilteredElementCollector(doc).OfClass(Grid).ToElements():\n    try:\n        grid_names.add(g_.Name)\n    except Exception:\n        pass\nn_grids = 0\nfor lv in data['levels']:\n    for gr in lv.get('grids', []):\n        if gr['name'] in grid_names:\n            continue\n        try:\n            a = XYZ(ft(gr['start'][0]), ft(gr['start'][1]), base_z); b = XYZ(ft(gr['end'][0]), ft(gr['end'][1]), base_z)\n            if a.DistanceTo(b) < 0.01:\n                continue\n            gg = Grid.Create(doc, Line.CreateBound(a, b))\n            try:\n                gg.Name = gr['name']\n            except Exception:\n                report.append('Aviso: no se pudo nombrar el eje %s (¿nombre repetido?)' % gr['name'])\n            grid_names.add(gr['name']); n_grids += 1\n        except Exception as ex:\n            report.append('Error en eje %s: %s' % (gr.get('name'), ex))\nif n_grids:\n    report.append('Ejes (rejillas) creados: %d' % n_grids)\n\nfor lv in data['levels']:\n    level, created = level_for(lv)\n    z0 = level.Elevation\n    report.append('— %s → nivel Revit \"%s\"%s (NPT %+.2f m)' % (lv.get('name'), level.Name, ' (nuevo)' if created else '', float(lv.get('elevation', 0))))\n    if not lv.get('rectified', True):\n        report.append('  Aviso: este nivel no estaba rectificado; las medidas pueden no ser a escala.')\n\n    def P3(x, y, z=0.0):\n        return XYZ(ft(x), ft(y), z0 + ft(z))\n\n    walls = {}\n    for w in lv.get('walls', []):\n        try:\n            a = P3(w['start'][0], w['start'][1]); b = P3(w['end'][0], w['end'][1])\n            if a.DistanceTo(b) < 0.01:\n                continue\n            wt = wall_type(float(w['thickness']))\n            wall = Wall.Create(doc, Line.CreateBound(a, b), wt.Id, level.Id, ft(w['height']), 0.0, False, False)\n            c = wall.get_Parameter(BuiltInParameter.ALL_MODEL_INSTANCE_COMMENTS)\n            if c:\n                c.Set('%s %s (levantamiento)' % (lv.get('name'), w['name']))\n            walls[w['id']] = (wall, a, b)\n        except Exception as ex:\n            report.append('  Error en muro %s: %s' % (w.get('name'), ex))\n    doc.Regenerate()\n\n    n_inst = 0; n_open = 0\n    for o in lv.get('openings', []):\n        try:\n            if o['wall'] not in walls:\n                continue\n            wall, a, b = walls[o['wall']]\n            d = b.Subtract(a).Normalize()\n            c = a.Add(d.Multiply(ft(o['center'])))\n            width = float(o['width']); height = float(o['height']); sill = float(o.get('sill', 0) or 0)\n            if o['kind'] == 'opening':\n                p1 = c.Subtract(d.Multiply(ft(width / 2))).Add(XYZ(0, 0, ft(sill)))\n                p2 = c.Add(d.Multiply(ft(width / 2))).Add(XYZ(0, 0, ft(sill + height)))\n                doc.Create.NewOpening(wall, p1, p2)\n                n_open += 1\n                continue\n            kind = 'door' if o['kind'] == 'door' else 'window'\n            sym = symbol_for(kind, width, height)\n            if sym is None:\n                report.append('  No hay familias de %s cargadas: se omitió %s' % ('puertas' if kind == 'door' else 'ventanas', o['name']))\n                continue\n            doc.Regenerate()\n            inst = doc.Create.NewFamilyInstance(XYZ(c.X, c.Y, z0), sym, wall, level, StructuralType.NonStructural)\n            if kind == 'window':\n                p = inst.get_Parameter(BuiltInParameter.INSTANCE_SILL_HEIGHT_PARAM)\n                if p and not p.IsReadOnly:\n                    p.Set(ft(sill))\n            else:\n                fl = int(o.get('flip', 0))\n                try:\n                    if fl & 1: inst.flipHand()\n                    if fl & 2: inst.flipFacing()\n                except Exception:\n                    pass\n            m = inst.get_Parameter(BuiltInParameter.ALL_MODEL_MARK)\n            if m:\n                m.Set(o['name'])\n            n_inst += 1\n        except Exception as ex:\n            report.append('  Error en vano %s: %s' % (o.get('name'), ex))\n\n    doc.Regenerate()\n    n_rooms = 0\n    for r in lv.get('rooms', []):\n        try:\n            room = doc.Create.NewRoom(level, UV(ft(r['at'][0]), ft(r['at'][1])))\n            p = room.get_Parameter(BuiltInParameter.ROOM_NAME)\n            if p:\n                p.Set(r['name'])\n            if r.get('height'):\n                up = room.get_Parameter(BuiltInParameter.ROOM_UPPER_OFFSET)\n                if up:\n                    up.Set(ft(r['height']))\n            n_rooms += 1\n        except Exception as ex:\n            report.append('  Habitación \"%s\" no creada: %s' % (r.get('name'), ex))\n    n_cols = 0\n    for c in lv.get('columns', []):\n        try:\n            sym, structural = column_symbol(float(c['width']), float(c['depth']))\n            if sym is None:\n                report.append('  No hay familias de pilares cargadas: se omitió %s' % c['name'])\n                continue\n            doc.Regenerate()\n            pt = P3(c['center'][0], c['center'][1])\n            inst = doc.Create.NewFamilyInstance(pt, sym, level, StructuralType.Column if structural else StructuralType.NonStructural)\n            top = inst.get_Parameter(BuiltInParameter.FAMILY_TOP_LEVEL_PARAM)\n            if top and not top.IsReadOnly:\n                top.Set(level.Id)\n            off = inst.get_Parameter(BuiltInParameter.FAMILY_TOP_LEVEL_OFFSET_PARAM)\n            if off and not off.IsReadOnly:\n                off.Set(ft(c['height']))\n            rot = float(c.get('rotation', 0) or 0)\n            if abs(rot) > 0.01:\n                axis = Line.CreateBound(pt, XYZ(pt.X, pt.Y, pt.Z + 1))\n                ElementTransformUtils.RotateElement(doc, inst.Id, axis, math.radians(rot))\n            m = inst.get_Parameter(BuiltInParameter.ALL_MODEL_MARK)\n            if m:\n                m.Set(c['name'])\n            n_cols += 1\n        except Exception as ex:\n            report.append('  Error en pilar %s: %s' % (c.get('name'), ex))\n    report.append('  Muros: %d · Puertas y ventanas: %d · Vanos: %d · Pilares: %d · Habitaciones: %d' % (len(walls), n_inst, n_open, n_cols, n_rooms))\n\nTransactionManager.Instance.TransactionTaskDone()\n\nOUT = report\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
